# Copie para .env e preencha. Nunca publique o .env (ele tem senhas e chaves).

# ---- básico
APP_NOME=Assistente Financeiro
DOMINIO=app.seudominio.com.br            # usado pelo docker-compose (HTTPS automático)
APP_URL=https://app.seudominio.com.br    # endereço público (retorno do Mercado Pago)
RESPONSAVEL=Seu nome ou sua empresa (CPF/CNPJ)   # aparece na política de privacidade
CONTATO_EMAIL=contato@seudominio.com.br
ADMIN_EMAILS=seu-email@gmail.com          # sempre Premium; veem o diagnóstico e exportam os dados

# ---- dados (escolha UM)
# PostgreSQL (recomendado). No docker-compose ele já vem pronto: só defina a senha.
POSTGRES_SENHA=troque-por-uma-senha-longa
# Fora do docker-compose, use um PostgreSQL gerenciado (ex.: Neon, gratuito):
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
# Ou arquivos num disco persistente montado:
# DATA_DIR=/dados

# ---- cadastro e login
CODIGO_CONVITE=                           # vazio = qualquer pessoa cria conta (normal na Play Store)
GOOGLE_CLIENT_ID=                         # ID do cliente OAuth (tipo "Aplicativo da Web") do Google Cloud
SMTP_HOST=                                # e-mail para "esqueci minha senha" (ex.: smtp.gmail.com, Brevo, SES)
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=

# ---- planos e assinatura
ASSINATURA=sim                            # nao = todos Premium (uso pessoal)
TESTE_GRATIS_DIAS=7
PRECO_MENSAL=14.90
PRECO_ANUAL=119.90
CODIGOS_PREMIUM=                          # ex.: AMIGOS30:30,LANCAMENTO:90 (código:dias)
CODIGO_MESTRE=                            # só seu: no app, 5 toques em "Versão" (menu da conta) pedem este código e liberam tudo sem pagar. Mínimo 8 caracteres; trocar o código revoga quem usou o antigo
# Google Play Billing (app Android)
ANDROID_PACKAGE=br.com.seudominio.financeiro
ANDROID_SHA256=                           # impressões digitais SHA-256 (chave de upload e a da Play), separadas por vírgula
PLAY_PRODUTO_MENSAL=premium_mensal
PLAY_PRODUTO_ANUAL=premium_anual
GOOGLE_PLAY_CONTA_SERVICO=                # JSON da conta de serviço com acesso ao Play Console (ou o caminho do arquivo)
RTDN_CHAVE=                               # segredo da URL de notificações do Google Play
# Mercado Pago (assinatura pelo site, fora do app da Play Store)
MERCADOPAGO_TOKEN=

# ---- inteligência artificial (opcional; só no Premium)
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5-5
MODELO_DECISOES=claude-opus-5-5
EFFORT_DECISOES=high

# ---- avisos
CRON_CHAVE=
VAPID_CONTATO=mailto:contato@seudominio.com.br
